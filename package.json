{
  "name": "aibro",
  "version": "0.1.0",
  "description": "Assistente nella taskbar per monitorare e interagire con gli agenti AI (Claude Code, Claude, ChatGPT, Copilot) e GitHub",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "hooks:install": "electron . --install-hooks",
    "hooks:uninstall": "electron . --uninstall-hooks",
    "buddy": "electron scripts/make-buddy.js",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron scripts/make-icon.js && electron-builder --win"
  },
  "author": "Stefano Facoetti",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309"
  },
  "productName": "AiBro",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "it.in4tek.aibro",
    "productName": "AiBro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "ui/**",
      "hooks/**",
      "aibro_orange.ico",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "artifactName": "AiBro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AiBro-${version}-portable.${ext}"
    }
  }
}
